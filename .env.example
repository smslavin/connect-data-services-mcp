# AVEVA Connect Data Services credentials
#
# Find these in the Connect portal (connect.aveva.com):
#   Tenant ID  — top-right corner, Account Settings
#   Client ID  — Security → Clients → your client application
#   Secret     — generated when you create or reset the client
#
# Leave all three unset (or delete this file) to run in demo mode.
# Demo mode uses pre-generated Aveva Water Authority mock data —
# no account required.

CONNECT_TENANT_ID=your-tenant-id-here
CONNECT_CLIENT_ID=your-client-id-here
CONNECT_CLIENT_SECRET=your-client-secret-here

# Cloud region for your Connect tenant (default: uswe = US West)
# Other common values: euno (EU North), apso (Asia Pacific South)
# Check the portal URL — the subdomain prefix is your region slug.
CONNECT_REGION=uswe

# OAuth 2.0 token endpoint (optional override)
# Default: https://identity.connect.aveva.com/{CONNECT_TENANT_ID}/connect/token
# Set this only if the default does not match your portal's identity endpoint.
# CONNECT_IDENTITY_URL=https://identity.connect.aveva.com/your-tenant-id/connect/token
