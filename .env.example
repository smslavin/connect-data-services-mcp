# AVEVA Connect Data Services credentials
#
# Find these in the Connect portal (connect.aveva.com):
#   Tenant ID  — top-right corner, Account Settings
#   Client ID  — Security → Clients → your client application
#   Secret     — generated when you create or reset the client
#
# Leave any of the four unset (or delete this file) to run in demo mode.
# Demo mode uses pre-generated Aveva Water Authority mock data —
# no account required.

CONNECT_TENANT_ID=your-tenant-id-here
CONNECT_CLIENT_ID=your-client-id-here
CONNECT_CLIENT_SECRET=your-client-secret-here

# Cloud region for your Connect tenant. Required: there is no default.
# Common values: uswe (US West), euno (EU North), apso (Asia Pacific South)
# Check the portal URL — the subdomain prefix is your region slug.
CONNECT_REGION=uswe

# Optional: read streams shared with you through a CONNECT community
# instead of your own namespaces. The client must be added to the community.
# CONNECT_COMMUNITY_ID=
